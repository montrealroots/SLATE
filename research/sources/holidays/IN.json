  {
   "url": "https://py.gov.in/sites/default/files/listofholidays-2026.pdf.pdf",
   "title": "Government of Puducherry, Home Department, G.O. Ms. No. 73 of 11 November 2025 (The Gazette of Puducherry, 13 November 2025): Public Holidays 2026",
   "read": "2026-10-27",
   "said": "(i) PUDUCHERRY AND KARAIKAL REGIONS 1. Thursday, the 01st January 2026 .. New Year 2. Thursday, the 15th January 2026 .. Pongal 3. Friday, the 16th January 2026 .. Thiruvalluvar Day/Mattu Pongal 4. Monday, the 26th January 2026 .. Republic Day 5. Friday, the 20th March 2026 .. Ramzan (Id-ul-Fitr)* 6. Friday, the 03rd April 2026 .. Good Friday 7. Tuesday, the 14th April 2026 .. Tamil New Year/Dr. Ambedkar’s Birthday 8. Friday, the 01st May 2026 .. May Day 9. Thursday, the 28th May 2026 .. Bakrid (Id-ul-Alha)* 10. Saturday, the 15th August 2026 .. Independence Day 11. Wednesday, the 26th August 2026 .. Milad-Un-Nabi 12. Monday, the 14th September 2026 .. Vinayagar Chathurthi 13. Friday, the 02nd October 2026 .. Gandhi Jayanthi 14. Monday, the 19th October 2026 .. Saraswathi Pooja/Ayudha Pooja 15. Sunday, the 01st November 2026 .. Puducherry Liberation Day 16. Sunday, the 08th November 2026 .. Deepavali 17. Friday, the 25th December 2026 .. Christmas (ii) MAHE REGION ... 5. Tuesday, the 14th April 2026 .. Vishu 1st Day/Dr. Ambedkar’s Birthday 6. Wednesday, the 15th April 2026 .. Vishu 2nd day ... 8. Wednesday, the 27th May 2026 .. Bakrid (Id-ul-Alha)* ... 10. Tuesday, the 25th August 2026 .. Onam 1st Day/Milad-Un-Nabi 11. Wednesday, the 26th August 2026 .. Onam 2nd Day ... 13. Thursday, the 15th October 2026 .. St. Theresa Festival 14. Monday, the 19th October 2026 .. Mahanavami ... (iii) YANAM REGION ... 5. Friday, the 20th March 2026 .. Ugadi / Ramzan (Id-ul-Fitr)* ... 14. Monday, the 19th October 2026 .. Mahanavami/Ayudha Pooja ... 3. No substitute holidays shall be allowed on any event for the festival holiday initially declared."
  },
  {
   "url": "https://py.gov.in/sites/default/files/home19032026go22.pdf",
   "title": "Government of Puducherry, Home Department, G.O. Ms. No. 22 of 19 March 2026 (corrigendum: Ramzan)",
   "read": "2026-10-27",
   "said": "Puducherry, Karaikal and Yanam For 20/03/2026 Read 21/03/2026 ... There will be no change in the Public Holiday already declared for Mahe Region on 20/03/2026 (Friday)."
  },
  {
   "url": "https://py.gov.in/sites/default/files/home13012026.pdf",
   "title": "Government of Puducherry, Home Department, G.O. Ms. No. 2 of 13 January 2026 (Bhogi)",
   "read": "2026-10-27",
   "said": "declare Holiday on 14/01/2026 (Wednesday) on account of Pongal Festival (Bhogi) for all Government Offices and Institutions in Puducherry, Karaikal and Yanam regions of Union Territory of Puducherry. In lieu thereof, 31/01/2026 (Saturday) will be a compensatory working day."
  },
  {
   "url": "https://www.py.gov.in/sites/default/files/home25062026go53.pdf",
   "title": "Government of Puducherry, Home Department, G.O. Ms. No. 53 of 25 June 2026 (Muharram)",
   "read": "2026-10-27",
   "said": "The Lieutenant Governor, Puducherry is pleased to declare 26th June,2026 (Friday) as Holiday to all Government Offices/Undertakings and Educational Institutions in the Union Territory of Puducherry on account of Muharam, which was earlier declared as a Restricted Holiday ... and in lieu thereof 04th July, 2026 (Saturday) shall be a working day."
  },
