  {
   "url": "https://solomons.gov.sb/wp-content/uploads/2025/11/Gaz-No.-157-Wednesday-5th-November-2025.pdf",
   "title": "Solomon Islands Gazette No. 157 (Extra-Ordinary), 5 November 2025, Notice [805]: Public Holidays Act (Cap. 151), National and Provincial Public Holidays 2026",
   "read": "2026-10-27",
   "said": "(a) Under section 2 of the Public Holidays Act (Cap. 151), the following days are to be kept as national public holidays in 2026: New Year’s Day 1 January Good Friday 3 April Holy Saturday 4 April Easter Monday 6 April Whit Monday 25 May Independence Day 7 July Christmas Day 25 December National Day of Thanksgiving 26 December (b) Under section 6 of the Public Holidays Act (Cap. 151), I, Minister for Home Affairs, Hon. Isikeli Tuwai Vave (Jnr), appoint the following days as provincial public holidays in 2026: Central Province 29 June Choiseul Province 25 February Guadalcanal Province 1 August (31 July to observed as a public holiday) Isabel Province 2 June Makira, Ulawa Province 3 August Malaita Province 15 August (14 August to be observed as a public holiday) Renell and Bellona Province 20 July Temotu Province 8 June Western Province 7 December"
  },
  {
   "url": "https://solomons.gov.sb/wp-content/uploads/2026/08/Gaz-No.-114-Monday-10th-August-2026.pdf",
   "title": "Solomon Islands Gazette No. 114 (Extra-Ordinary), 10 August 2026, Notice [689]: Amendment of Gazette Notice No. [805] of 2025",
   "read": "2026-10-27",
   "said": "I, Hon. Manasseh Maelanga, Minister for Home Affairs, under section 6 of the Public Holidays Act (Cap. 151), and with reference to section 36(a) of the Interpretation and General Provisions Act (Cap. 85), amend Gazette Notice No. [805] of 2025 in paragraph (b) by deleting row 6 of the tab le and substituting the following: “ Malaita Province 18 November ”"
  },
  {
   "url": "https://solomons.gov.sb/wp-content/uploads/2025/04/2025-public-Holidays-calendar_.pdf",
   "title": "Ministry of Home Affairs, Public Notice No: 1/2025, National and Provincial Public Holidays 2025: a Sunday's day kept on the Monday",
   "read": "2026-10-27",
   "said": "TEMOTU PROVINCE Sunday 8th June (Monday 9th June to be observe as Public Holiday) CENTRAL PROVINCE Sunday 29th June (Monday 30th June to be observed as Public Holiday) RENBEL PROVINCE Sunday 20th July (Monday 21st July to be observe as public holiday)"
  }
